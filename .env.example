# =============================================================================
# z-graphrag-k 配置模板
# 复制为 .env 后按需修改。所有服务均可通过环境变量切换。
#
# 说明：Embedding / LLM 的模型与连接信息现在统一在「模型管理」页面维护，
#       本文件里的 EMBEDDING_* / LLM_* / ANTHROPIC_* / OLLAMA_* 仅在
#       「系统配置」里未选择模型时作为回退默认值。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 应用
# -----------------------------------------------------------------------------
APP_NAME=z-graphrag-k
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. 向量库 (Milvus)
#    provider=lite   → 本地文件库，无需容器（开发首选）
#    provider=milvus → 连接独立 Milvus 服务
# -----------------------------------------------------------------------------
VECTORSTORE_PROVIDER=lite
VECTORSTORE_COLLECTION=kgrag_chunks
VECTORSTORE_METRIC=IP
VECTORSTORE_INDEX_TYPE=AUTOINDEX

# Milvus Lite 本地文件路径（provider=lite 时生效）
VECTORSTORE_LITE_PATH=./data/milvus/kgrag.db

# Milvus 服务端（provider=milvus 时生效）
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default

# -----------------------------------------------------------------------------
# 3. Embedding 模型
#    provider=local  → sentence-transformers 本地推理（需 [local] 依赖）
#    provider=openai → OpenAI 兼容接口
#    provider=ollama → Ollama 服务
#    provider=hash   → 确定性哈希占位（仅用于跑通链路，无语义）
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_NORMALIZE=true

# 本地模型目录（模型已下载时直接指向，避免联网）
# 留空则按 EMBEDDING_MODEL 从 HF 缓存/网络加载
EMBEDDING_LOCAL_PATH=./models/bge-m3

# 网络不通时可设 HF 镜像
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0

# openai provider
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ollama provider
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# 4. LLM 模型
#    provider=anthropic | openai | ollama | mock
#    默认 anthropic（Claude）；需要 OpenAI 兼容端点时改成 openai
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
# 留空则按 provider 取下面的默认模型（anthropic→ANTHROPIC_MODEL 等）
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# OpenAI 兼容端点（DeepSeek / vLLM / 公司网关等）
# LLM_PROVIDER=openai 时使用
LLM_API_BASE=
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini

# Anthropic / Claude
# LLM_PROVIDER=anthropic 时使用
ANTHROPIC_API_BASE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# 5. 图数据库 (Neo4j) —— 暂不启用
# -----------------------------------------------------------------------------
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# 6. 切分与检索
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

# -----------------------------------------------------------------------------
# 7. 数据目录
# -----------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# 8. 管理员账号（只由环境变量决定，唯一）
#    首次启动会创建管理员；密码不填则随机生成并打印到日志
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 9. AD 域认证（可选，也可在管理页面配置）
# -----------------------------------------------------------------------------
AD_ENABLED=false
AD_SERVER_URI=
AD_USE_SSL=false
AD_BASE_DN=
AD_USER_FILTER=(sAMAccountName={username})
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_DISPLAY_NAME_ATTR=displayName
AD_EMAIL_ATTR=mail
