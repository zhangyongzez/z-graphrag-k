# 统一换行符：源码用 LF，Windows 脚本用 CRLF
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须 LF（否则 Linux 下 shebang 失效）
*.sh text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.safetensors binary
*.bin binary
*.onnx binary
